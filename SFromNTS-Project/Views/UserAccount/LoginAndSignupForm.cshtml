<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login / Sign Up</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800;900&family=Barlow:wght@300;400;500&display=swap"
          rel="stylesheet" />
    <link href="/css/LoginAndSignupForm.css" rel="stylesheet" />
</head>
<body>

    <div class="card">

        <!-- LOGIN panel -->
        <div class="panel panel-login" id="panelLogin" onclick="openPanel('login')">
            <div class="idle-label login-label" id="labelLogin">
                <span>Login</span>
            </div>
            <div class="form-wrap" id="formLogin">
                <button class="close-btn" onclick="closePanel(event)" aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                </button>
                <div class="form-inner">
                    <div class="form-title">Login</div>
                    <div class="form-sub">Welcome back.</div>
                    <div class="fields">
                        <div>
                            <label class="field-label" for="loginEmail">Email</label>
                            <input type="email" id="loginEmail" placeholder="your@email.com" />
                        </div>
                        <div>
                            <label class="field-label" for="loginPass">Password</label>
                            <input type="password" id="loginPass" placeholder="••••••••" />
                        </div>
                        <div class="check-row">
                            <input type="checkbox" id="remember" />
                            <label for="remember">Remember me</label>
                        </div>
                    </div>
                    <button class="btn">Sign In</button>
                    <p class="forgot"><a href="#">Forgot password?</a></p>
                </div>
            </div>
        </div>

        <!-- SIGN UP panel -->
        <div class="panel panel-signup" id="panelSignup" onclick="openPanel('signup')">
            <div class="idle-label signup-label" id="labelSignup">
                <span>Sign<br>Up</span>
            </div>
            <div class="form-wrap" id="formSignup">
                <button class="close-btn" onclick="closePanel(event)" aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                </button>
                <div class="form-inner">
                    <div class="form-title">Sign Up</div>
                    <div class="form-sub">Create your account.</div>
                    <div class="fields">
                        <div>
                            <label class="field-label" for="signupName">Tên</label>
                            <input type="text" id="signupName" placeholder="Nhập tên của bạn" required />
                            <label class="field-label" for="signupSurname" >Họ</label>
                            <input type="text" id="signupSurname" placeholder="Nhập họ của bạn" required />
                            <label class="field-label" for="signupDOB">Ngày Sinh</label>
                            <input type="date" id="signupDOB" placeholder="dd/mm/yyyy" required />
                            <label class="field-label" for="signupOcupation">Nghề nghiệp</label>
                            <select name="ocupation" id="signupOcupation">
                                <option value="Sinh viên">Sinh viên</option>
                                <option value="Giáo viên">Giáo viên</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div>
                            <label class="field-label" for="signupEmail">Email</label>
                            <input type="email" id="signupEmail" placeholder="your@email.com" required />
                        </div>
                        <div>
                            <label class="field-label" for="signupPass">Password</label>
                            <input type="password" id="signupPass" placeholder="••••••••" required />
                        </div>
                        <div class="check-row">
                            <input type="checkbox" id="terms" />
                            <label for="terms">
                                I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
                            </label>
                        </div>
                    </div>
                    <button class="btn">Create Account</button>
                </div>
            </div>
        </div>

        <!-- Diagonal divider -->
        <div class="divider" id="divider">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <line x1="0" y1="0" x2="100" y2="100" stroke="rgba(255,255,255,0.12)" stroke-width="0.5"
                      vector-effect="non-scaling-stroke" />
            </svg>
        </div>

    </div>
    
</body>
</html>
<script src="~/js/LoginAndSignupForm.js"></script>

